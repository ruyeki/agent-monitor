{
  "name": "agent-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Monitor: live view and workflow engine for Fable runs",
  "engines": { "node": ">=22.14" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning bin/agent-monitor.js serve",
    "build": "npm --prefix web run build",
    "postinstall": "cd web && npm install",
    "test": "node --test \"test/**/*.test.js\"",
    "integrate": "node scripts/integrate.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  }
}
